// attention_gqa.comp — grouped-query attention, one invocation per Q head.
// Mirrors the CUDA `attention_gqa` kernel: online softmax over positions,
// kv_head = q_head / (n_q_heads / n_kv_heads), f16 KV cache, scale applied
// to the score. The layer slice offset is folded into `cache_off` (in f16
// elements) by the backend, exactly as the CUDA backend folds it into its
// cache pointers. Bindings: 0=q(f32), 1=kc(u32 packed f16),
// 2=vc(u32 packed f16), 3=out(f32).
// Push: seq_len, n_q_heads, n_kv_heads, head_dim, scale, cache_off.
// head_dim is capped at 512 (no real model exceeds 256); the backend
// refuses larger head_dim at dispatch.
#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer KC { uint kc[]; };
layout(set = 0, binding = 2) readonly buffer VC { uint vc[]; };
layout(set = 0, binding = 3) buffer O { float o[]; };
layout(push_constant) uniform PC {
    uint seq_len; uint n_q_heads; uint n_kv_heads;
    uint head_dim; float scale; uint cache_off;
} pc;
#define VBS_MAX_HEAD_DIM 512u
void main() {
    uint head = gl_GlobalInvocationID.x;
    if (head >= pc.n_q_heads) return;
    if (pc.head_dim == 0u || pc.head_dim > VBS_MAX_HEAD_DIM) return;
    if (pc.n_kv_heads == 0u || pc.seq_len == 0u) return;
    uint kv_head = head / (pc.n_q_heads / pc.n_kv_heads);
    float acc[VBS_MAX_HEAD_DIM];
    for (uint d = 0u; d < pc.head_dim; d++) acc[d] = 0.0;
    float m = -3.4028235e38; // -FLT_MAX, matches the PTX init
    float l = 0.0;
    for (uint s = 0u; s < pc.seq_len; s++) {
        float dotp = 0.0;
        uint kbase = pc.cache_off + (s * pc.n_kv_heads + kv_head) * pc.head_dim;
        for (uint d = 0u; d < pc.head_dim; d++) {
            uint idx = kbase + d;
            uint w = kc[idx >> 1];
            float kv = ((idx & 1u) == 0u) ? unpackHalf2x16(w).x
                                          : unpackHalf2x16(w).y;
            dotp += q[head * pc.head_dim + d] * kv;
        }
        float score = dotp * pc.scale;
        float m_new = max(m, score);
        float r = exp(m - m_new);
        float e = exp(score - m_new);
        l = l * r + e;
        m = m_new;
        for (uint d = 0u; d < pc.head_dim; d++) {
            uint idx = kbase + d;
            uint w = vc[idx >> 1];
            float vv = ((idx & 1u) == 0u) ? unpackHalf2x16(w).x
                                          : unpackHalf2x16(w).y;
            acc[d] = acc[d] * r + e * vv;
        }
    }
    float inv = 1.0 / l;
    for (uint d = 0u; d < pc.head_dim; d++)
        o[head * pc.head_dim + d] = acc[d] * inv;
}
