// rms_norm.comp — out[i] = x[i] / sqrt(mean(x^2) + eps) * w[i]
// Mirrors the CUDA `rms_norm` kernel: every invocation redundantly sums
// the whole row (simple, correct; matches PTX semantics), then scales its
// own element. Bindings: 0=x(f32), 1=w(f32), 2=y(f32). Push: n, eps.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { float w[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
layout(push_constant) uniform PC { uint n; float eps; } pc;
void main() {
    float ss = 0.0;
    for (uint j = 0u; j < pc.n; j++) ss += x[j] * x[j];
    float scale = 1.0 / sqrt(ss / float(pc.n) + pc.eps);
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    y[i] = x[i] * scale * w[i];
}
