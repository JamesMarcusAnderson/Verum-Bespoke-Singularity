// embed_f32.comp — out[i] = w[token * dim + i] (f32 table)
// Mirrors the CUDA `embedding_lookup` kernel.
// Bindings: 0=w(f32), 1=out(f32). Push: token, dim.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { float w[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    o[i] = w[pc.token * pc.dim + i];
}
