// matvec_lns8.comp — LNS8 weights (log-domain int8), dequantized on the fly.
// Mirrors the CUDA `matvec_lns8` kernel. Block (36 B): 32 x u8 log-values,
// f32 scale at byte 32; value = 2^q * scale.
// Bindings: 0=w(u32 words over packed bytes), 1=x(f32), 2=y(f32).
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
#include "common.glsl"
#include "matvec_common.glsl"
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;
    uint nblocks = pc.cols / 32u;
    uint row_bytes = nblocks * 36u;
    float sum = 0.0;
    for (uint b = 0u; b < nblocks; b++) {
        uint base = (pc.row_base + row) * row_bytes + b * 36u;
        float s = load_f32(base + 32u);
        uint q = load_u8(base + lane);
        sum += exp2(float(q)) * s * x[pc.col_off + b * 32u + lane];
    }
    matvec_finish(sum, row);
}
