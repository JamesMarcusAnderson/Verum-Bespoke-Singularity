// matvec_q8_0.comp — Q8_0 weights, dequantized on the fly.
// Mirrors the CUDA `matvec_q8_0` kernel. Block (34 B): f16 d, 32 x i8.
// Bindings: 0=w(u32 words over packed bytes), 1=x(f32), 2=y(f32).
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
#include "common.glsl"
#include "matvec_common.glsl"
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;
    uint nblocks = pc.cols / 32u;
    uint row_bytes = nblocks * 34u;
    float sum = 0.0;
    for (uint b = 0u; b < nblocks; b++) {
        uint base = (pc.row_base + row) * row_bytes + b * 34u;
        float d = load_f16(base);
        int q = load_i8(base + 2u + lane);
        sum += d * float(q) * x[pc.col_off + b * 32u + lane];
    }
    matvec_finish(sum, row);
}
