// embed_f16.comp — out[i] = f16 w[token * dim + i], dequantized on the fly.
// Mirrors the CUDA `embedding_lookup_f16` kernel. The f16 table is bound
// as a uint array (two f16 per word); no 16-bit storage extension needed.
// Bindings: 0=w(u32 packed f16), 1=out(f32). Push: token, dim.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint w[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    uint idx = pc.token * pc.dim + i;
    uint word = w[idx >> 1];
    o[i] = ((idx & 1u) == 0u) ? unpackHalf2x16(word).x
                              : unpackHalf2x16(word).y;
}
