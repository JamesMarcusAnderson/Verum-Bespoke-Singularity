// add.comp — residual add: out[i] = a[i] + b[i]
// Mirrors the CUDA `residual_add` kernel. Bindings: 0=a(f32), 1=b(f32),
// 2=out(f32). Push: n.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    o[i] = a[i] + b[i];
}
