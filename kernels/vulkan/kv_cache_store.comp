// kv_cache_store.comp — store f32 K/V into the f16 KV caches at (layer, pos).
// Mirrors the CUDA `kv_cache_store` kernel. Index:
//   (layer * max_ctx + pos) * kv_dim + i, stored as f16.
// One invocation per f16 PAIR (packs two halves into one u32 word, so no
// 16-bit storage extension is needed and no two invocations share a word).
// Requires even kv_dim (true for every real model: head_dim is even);
// the backend refuses odd kv_dim. Bindings: 0=k(f32), 1=v(f32),
// 2=kc(u32 packed f16), 3=vc(u32 packed f16). Push: pos, layer, max_ctx, kv_dim.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer K { float k[]; };
layout(set = 0, binding = 1) readonly buffer V { float v[]; };
layout(set = 0, binding = 2) buffer KC { uint kc[]; };
layout(set = 0, binding = 3) buffer VC { uint vc[]; };
layout(push_constant) uniform PC {
    uint pos; uint layer; uint max_ctx; uint kv_dim;
} pc;
void main() {
    uint p = gl_GlobalInvocationID.x;
    uint npairs = (pc.kv_dim + 1u) / 2u;
    if (p >= npairs) return;
    uint e0 = 2u * p;
    uint e1 = e0 + 1u;
    uint base = (pc.layer * pc.max_ctx + pc.pos) * pc.kv_dim + e0;
    float k0 = k[e0];
    float k1 = (e1 < pc.kv_dim) ? k[e1] : k0;
    float v0 = v[e0];
    float v1 = (e1 < pc.kv_dim) ? v[e1] : v0;
    uint widx = base >> 1;
    kc[widx] = packHalf2x16(vec2(k0, k1));
    vc[widx] = packHalf2x16(vec2(v0, v1));
}
