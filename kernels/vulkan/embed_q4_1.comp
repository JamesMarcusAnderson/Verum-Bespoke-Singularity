// embed_q4_1.comp — Q4_1 row lookup, dequantized on the fly.
// Block (20 B): f16 d, f16 m, 16 nibble bytes. Mirrors deq_q4_1().
// Bindings: 0=w(u32 words over packed bytes), 1=out(f32). Push: token, dim.
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
#include "common.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    uint row_bytes = (pc.dim / 32u) * 20u;
    uint base = pc.token * row_bytes + (i / 32u) * 20u;
    float d = load_f16(base);
    float m = load_f16(base + 2u);
    uint j = i % 32u;
    uint byte = load_u8(base + 4u + (j & 15u));
    uint nib = (j < 16u) ? (byte & 15u) : (byte >> 4u);
    o[i] = d * float(nib) + m;
}
