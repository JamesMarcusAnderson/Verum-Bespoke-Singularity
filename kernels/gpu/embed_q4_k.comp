// embed_q4_k.comp — copy one row of a Q4_K embedding table,
// unpacked to f32 on the fly (unpack_q4k in common.glsl).
// Bindings: 0=w (u32 words over packed bytes), 1=out (f32).
// Push: token, dim.
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
#include "common.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    uint row_bytes = (pc.dim / 256u) * 144u;
    uint block = pc.token * row_bytes + (i / 256u) * 144u;
    o[i] = unpack_q4k(block, i % 256u);
}
