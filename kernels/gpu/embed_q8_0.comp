// embed_q8_0.comp — copy one row of a Q8_0 embedding table,
// unpacked to f32 on the fly. Block (34 bytes): half scale,
// 32 signed bytes.
// Bindings: 0=w (u32 words over packed bytes), 1=out (f32).
// Push: token, dim.
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
#include "common.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    uint row_bytes = (pc.dim / 32u) * 34u;
    uint block = pc.token * row_bytes + (i / 32u) * 34u;
    o[i] = unpack_q8_0(block, i % 32u);
}
