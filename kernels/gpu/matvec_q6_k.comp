// matvec_q6_k.comp — y[row] = dot(w[row, :], x[...]) with Q6_K
// weights, unpacked on the fly (unpack_q6k). Each lane covers
// elements lane, lane+32, ..., lane+224 of every 256-element block.
// Bindings: 0=w (u32 words over packed bytes), 1=x (f32), 2=y (f32).
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
#include "common.glsl"
#include "matvec_common.glsl"
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;
    uint block_count = pc.cols / 256u;
    uint row_bytes = block_count * 210u;
    uint weight_row = (pc.row_base + row) * row_bytes;
    float sum = 0.0;
    for (uint b = 0u; b < block_count; b++) {
        uint block = weight_row + b * 210u;
        uint x_base = pc.col_off + b * 256u;
        for (uint k = 0u; k < 8u; k++) {
            uint e = lane + 32u * k;
            sum += unpack_q6k(block, e) * x[x_base + e];
        }
    }
    matvec_store(sum, row);
}
