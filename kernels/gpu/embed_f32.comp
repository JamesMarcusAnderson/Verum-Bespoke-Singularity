// embed_f32.comp — copy one row of an f32 embedding table:
// out[i] = w[token * dim + i].
// Bindings: 0=w (f32), 1=out (f32). Push: token, dim.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { float w[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.dim) o[i] = w[pc.token * pc.dim + i];
}
