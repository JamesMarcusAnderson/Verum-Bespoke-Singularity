// rms_norm.comp — out[i] = x[i] / sqrt(mean(x^2) + eps) * w[i].
// Every invocation sums the whole row itself (simple and correct for
// the short rows this kernel serves), then scales its own element.
// Bindings: 0=x (f32), 1=w (f32), 2=y (f32). Push: n, eps.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { float w[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
layout(push_constant) uniform PC { uint n; float eps; } pc;
void main() {
    float squares = 0.0;
    for (uint j = 0u; j < pc.n; j++) squares += x[j] * x[j];
    float inv_rms = 1.0 / sqrt(squares / float(pc.n) + pc.eps);
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) y[i] = x[i] * inv_rms * w[i];
}
