// embed_f16.comp — copy one row of an f16 embedding table,
// unpacked to f32 on the fly. The table is bound as a uint array
// (two halves per word); no 16-bit storage feature is needed.
// Bindings: 0=w (u32 packed f16), 1=out (f32). Push: token, dim.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer W { uint w[]; };
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(push_constant) uniform PC { uint token; uint dim; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dim) return;
    uint at = pc.token * pc.dim + i;
    vec2 halves = unpackHalf2x16(w[at >> 1]);
    o[i] = (at & 1u) == 0u ? halves.x : halves.y;
}
