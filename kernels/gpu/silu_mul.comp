// silu_mul.comp — gated SiLU: out[i] = gate[i] * sigmoid(gate[i]) * up[i].
// The sigmoid uses the precise exponential, not a fast approximation.
// Bindings: 0=gate (f32), 1=up (f32), 2=out (f32). Push: n.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer G { float g[]; };
layout(set = 0, binding = 1) readonly buffer U { float u[]; };
layout(set = 0, binding = 2) buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float gate = g[i];
    float activated = gate / (1.0 + exp(-gate));
    o[i] = activated * u[i];
}
