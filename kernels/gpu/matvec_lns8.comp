// matvec_lns8.comp — y[row] = dot(w[row, :], x[...]) with LNS8
// weights (log-domain int8), unpacked on the fly. Block (36 bytes):
// 32 unsigned log-values, then an f32 scale at byte 32; each value
// is 2^q * scale. Each lane takes one element per block.
// Bindings: 0=w (u32 words over packed bytes), 1=x (f32), 2=y (f32).
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(set = 0, binding = 0) readonly buffer W { uint w_words[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };
#include "common.glsl"
#include "matvec_common.glsl"
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;
    uint block_count = pc.cols / 32u;
    uint row_bytes = block_count * 36u;
    uint weight_row = (pc.row_base + row) * row_bytes;
    float sum = 0.0;
    for (uint b = 0u; b < block_count; b++) {
        uint block = weight_row + b * 36u;
        float scale = float_at(block + 32u);
        uint exponent = byte_at(block + lane);
        sum += exp2(float(exponent)) * scale * x[pc.col_off + b * 32u + lane];
    }
    matvec_store(sum, row);
}
